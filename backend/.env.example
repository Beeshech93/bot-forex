APP_NAME=Smart Signals FX API
ENVIRONMENT=development
# Generate a random value with at least 32 characters before exposing protected routes.
API_TOKEN=replace-with-a-random-secret-of-at-least-32-characters
CORS_ORIGINS=["http://localhost:3000"]
LOG_LEVEL=INFO
# Optional path to terminal64.exe on the Windows VPS.
MT5_TERMINAL_PATH=
# PostgreSQL in production; SQLite is the local development default.
DATABASE_URL=sqlite:///./smart_signals_fx.db
